#!/usr/bin/env sh

### ================================
### ENVIRONMENT PRE-COMMIT HOOK
### ================================

set -e

_repo_root="$(git rev-parse --show-toplevel 2> "/dev/null" || pwd)"
cd "${_repo_root}"

echo "🔍 [pre-commit] Executing Universal Environment hub quality gates..."

### --------------------------------
### Whitespace & Formatting Check
### --------------------------------
echo "  ↳ Checking whitespace and formatting (git diff --check)..."
if ! git diff --check --cached; then
	echo "❌ [pre-commit] Whitespace or EOF formatting error detected!" >&2
	echo "   Run 'git diff --check --cached' to inspect issues." >&2
	exit 1
fi

### --------------------------------
### Git Index File Modes Check
### --------------------------------
echo "  ↳ Validating Git Index file modes (0755 vs 0644)..."
_staged_files=$(git diff --cached --name-only --diff-filter=d 2> "/dev/null" || true)
if [ -n "${_staged_files}" ]; then
	_bad_modes=0
	for _f in ${_staged_files}; do
		[ ! -f "${_f}" ] && continue
		_meta=$(git ls-files -s -- "${_f}" 2> "/dev/null" || true)
		[ -z "${_meta}" ] && continue
		_mode=$(echo "${_meta}" | awk '{print $1}')
		case "${_mode}" in
			160000|120000) continue ;;
		esac

		_has_shebang=0
		read -r _first_line < "${_f}" 2> "/dev/null" || _first_line=""
		case "${_first_line}" in
			"#!"*) _has_shebang=1 ;;
		esac

		case "${_f}" in
			.githooks/*) _is_hook=1 ;;
			*) _is_hook=0 ;;
		esac

		case "${_f}" in
			*.md|*.txt|*.json|*.yaml|*.yml|*.toml|*.el|*.lua|*.vim|*.ini|*.conf|*.css|*.html|*.svg|*.png|*.jpg|*.sample|.gitignore|.gitmodules|.gitattributes)
				_is_doc=1 ;;
			*) _is_doc=0 ;;
		esac

		if [ "${_mode}" = "100755" ]; then
			if [ "${_is_doc}" -eq 1 ] && [ "${_is_hook}" -eq 0 ]; then
				echo "❌ [pre-commit] Arquivo de documentação/dados com bit executável no Git Index: ${_f}" >&2
				echo "   Execute: git update-index --chmod=-x \"${_f}\"" >&2
				_bad_modes=$((_bad_modes + 1))
			elif [ "${_has_shebang}" -eq 0 ] && [ "${_is_hook}" -eq 0 ]; then
				case "${_f}" in
					*.cmd|*.ps1|*.nu|*.bat) ;;
					*)
						echo "❌ [pre-commit] Arquivo sem shebang com bit executável no Git Index: ${_f}" >&2
						echo "   Execute: git update-index --chmod=-x \"${_f}\"" >&2
						_bad_modes=$((_bad_modes + 1))
						;;
				esac
			fi
		elif [ "${_mode}" = "100644" ]; then
			if [ "${_is_hook}" -eq 1 ] && [ "${_f##*.}" != "sample" ]; then
				echo "❌ [pre-commit] Gancho Git sem permissão de execução no Git Index: ${_f}" >&2
				echo "   Execute: git update-index --chmod=+x \"${_f}\"" >&2
				_bad_modes=$((_bad_modes + 1))
			elif [ "${_has_shebang}" -eq 1 ]; then
				echo "❌ [pre-commit] Script com shebang sem permissão de execução no Git Index: ${_f}" >&2
				echo "   Execute: git update-index --chmod=+x \"${_f}\"" >&2
				_bad_modes=$((_bad_modes + 1))
			fi
		fi
	done
	if [ "${_bad_modes}" -gt 0 ]; then
		exit 1
	fi
fi

### --------------------------------
### Submodules Integrity Check
### --------------------------------
echo "  ↳ Validating git submodules status..."
git submodule status

### --------------------------------
### Shell Scripts Syntax Check
### --------------------------------
echo "  ↳ Validating shell scripts syntax..."
find . -name "*.sh" -not -path "*/.git/*" -exec sh -n {} +

### --------------------------------
### Banner Geometry & Length Check
### --------------------------------
if command -v python3 > "/dev/null" 2>&1; then
	_staged_sh=$(git diff --cached --name-only --diff-filter=d | grep '\.sh$' 2> "/dev/null" || true)
	if [ -n "${_staged_sh}" ]; then
		echo "  ↳ Validating banner geometry (32/64 cols)..."
		python3 -c '
import sys, re
failed = False
for f in sys.argv[1:]:
    with open(f, "r", encoding="utf-8", errors="ignore") as fp:
        lines = [l.rstrip("\r\n") for l in fp]
    for idx, line in enumerate(lines, 1):
        m_sec = re.match(r"^###\s+(=+|-+)$", line)
        if m_sec and len(m_sec.group(1)) != 32:
            print(f"❌ {f}:L{idx}: Régua de seção possui {len(m_sec.group(1))} caracteres (esperado 32)")
            failed = True
        prev_line = lines[idx - 2] if idx >= 2 else ""
        next_line = lines[idx] if idx < len(lines) else ""
        if (re.match(r"^###\s+(=|-){32}$", prev_line) or re.match(r"^###\s+(=|-){32}$", next_line)) and line.startswith("### "):
            title = line[4:]
            if len(title) > 32:
                print(f"❌ {f}:L{idx}: Título vazou 32 colunas ({len(title)} cols): {title}")
                failed = True
            if re.search(r"[\(\)\[\]]", title):
                print(f"❌ {f}:L{idx}: Título contém parênteses/colchetes: {title}")
                failed = True
        if idx <= 6:
            m_hdr = re.match(r"^#\s+(-+)$", line)
            if m_hdr and len(m_hdr.group(1)) >= 20 and len(m_hdr.group(1)) != 64:
                print(f"❌ {f}:L{idx}: Régua de cabeçalho possui {len(m_hdr.group(1))} hífens (esperado 64)")
                failed = True
            if (re.match(r"^#\s+-{64}$", prev_line) or re.match(r"^#\s+-{64}$", next_line)) and line.startswith("# "):
                title = line[2:]
                if len(title) > 64:
                    print(f"❌ {f}:L{idx}: Título de cabeçalho vazou 64 hífens ({len(title)} cols): {title}")
                    failed = True
if failed:
    sys.exit(1)
' ${_staged_sh}
	fi
fi

### --------------------------------
### Markdown Prettier Validation
### --------------------------------
if command -v prettier > "/dev/null" 2>&1; then
	echo "  ↳ Validating staged Markdown files with Prettier..."
	_unformatted_md=""
	for _md_file in $(git diff --cached --name-only --diff-filter=d | grep '\.md$' || true); do
		if [ -f "${_md_file}" ] && ! prettier --check "${_md_file}" > "/dev/null" 2>&1; then
			_unformatted_md="${_unformatted_md} ${_md_file}"
		fi
	done
	if [ -n "${_unformatted_md}" ]; then
		echo "❌ [pre-commit] Unformatted Markdown files detected:${_unformatted_md}" >&2
		echo "   Run 'prettier --write <file>' or 'make format' to fix." >&2
		exit 1
	fi
fi

echo "✅ [pre-commit] Universal Environment quality gates passed cleanly!"
exit 0
